# Server-only configuration. Mock remains the default; no credentials required.
INSTELLIX_MODE=mock
# Leave false until company approval and tenant endpoint/permission checks are complete.
INSTELLIX_CONNECTIVITY_APPROVED=false
# Use the exact staging API origin provided during tenant onboarding (no path).
INSTELLIX_API_BASE_URL=https://staging-api.example
INSTELLIX_REALM=your-tenant-realm
INSTELLIX_CLIENT_ID=your-client-id
INSTELLIX_CLIENT_SECRET=replace-locally
